{
    "_description": "OpenSMILE + XGBoost/LightGBM для классификации эмоций из аудио",
    "_script": "dusha/my_experiments/audio_models/baseline/openSmile_XGBoost.py",

    "opensmile": {
        "feature_set": "eGeMAPSv02",
        "feature_level": "Functionals"
    },
    "xgboost": {
        "n_estimators": 500,
        "learning_rate": 0.05,
        "max_depth": 6,
        "subsample": 0.9,
        "colsample_bytree": 0.9,
        "reg_lambda": 1.0,
        "reg_alpha": 0.0,
        "tree_method": "hist",
        "eval_metric": "mlogloss"
    },
    "lightgbm": {
        "n_estimators": 500,
        "learning_rate": 0.05,
        "max_depth": 6,
        "subsample": 0.9,
        "colsample_bytree": 0.9,
        "reg_lambda": 1.0,
        "reg_alpha": 0.0
    },
    "random_state": 42
}
