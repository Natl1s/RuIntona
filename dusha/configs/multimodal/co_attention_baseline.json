{
    "_description": "Co-Attention Baseline — перекрёстное внимание между текстом и аудио (Wav2Vec2 + RuBERT)",
    "_script": "dusha/my_experiments/multimodal/co-attention/Co_Attention_Baseline.py",

    "audio_pretrained_name": "facebook/wav2vec2-xls-r-300m",
    "d_model": 384,
    "num_heads": 8,
    "num_coattn_blocks": 2,
    "ffn_mult": 4,
    "dropout": 0.2,
    "classifier_layers": [384, 192],
    "unfreeze_audio_layers": 4,
    "unfreeze_text_layers": 4,
    "min_crop_sec": 4.0,
    "max_crop_sec": 6.0,
    "batch_size": 4,
    "eval_batch_size": null,
    "num_workers": 2,
    "prefetch_factor": 2,
    "stage1_epochs": 2,
    "lr_head": 1e-5,
    "lr_encoder": 5e-6,
    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "grad_clip_norm": 1.0,
    "early_stopping_patience": 4,
    "gradient_checkpointing": true,
    "stage2_micro_batch_size": 1,
    "use_class_weights": false,
    "seed": 42
}
