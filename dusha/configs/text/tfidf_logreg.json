{
    "_description": "TF-IDF + Logistic Regression для классификации эмоций по тексту",
    "_script": "dusha/my_experiments/text_models/baseline/TF-IDF_LogReg.py",

    "tfidf": {
        "ngram_range": [1, 2],
        "max_features": 10000,
