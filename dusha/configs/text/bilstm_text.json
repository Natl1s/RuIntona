{
    "_description": "BiLSTM для классификации эмоций по тексту (обучаемый vocabulary + embedding слой)",
    "_script": "dusha/my_experiments/text_models/RNN/BiLSTM_Text.py",

    "embed_dim": 256,
    "hidden_size": 128,
    "lstm_layers": 2,
    "lstm_dropout": 0.2,
    "classifier_dropout": 0.3,
    "bidirectional": true,
    "max_vocab_size": 40000,
    "min_freq": 2,
    "max_len": 256,
    "epochs": 12,
    "batch_size": 64,
    "lr": 0.001,
    "weight_decay": 1e-5,
    "grad_clip": 1.0,
    "num_workers": 0,
    "seed": 42
}
