# Обученные веса (публикуются отдельно, например на HuggingFace Hub)
# Исключение: JSON-отчёты оценки предобученных моделей (checkpoints/pretrained/*_eval_*.json) отслеживаются
ruintona/my_experiments/checkpoints/*
!ruintona/my_experiments/checkpoints/pretrained/
ruintona/my_experiments/checkpoints/pretrained/*
!ruintona/my_experiments/checkpoints/pretrained/*_eval_*.json

# Локальная конфигурация с абсолютным путём к датасету
ruintona/my_experiments/data.json

# Артефакты smoke-тестов (генерируются при каждом прогоне pytest).
# ВАЖНО: настоящие результаты экспериментов используют ту же схему имени —
# их можно коммитить как git add -f.
ruintona/my_experiments/multimodal/early_fusion/results/early_fusion_baseline_results_*.json

